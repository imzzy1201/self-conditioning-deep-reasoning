# Copy to `.env` and fill in real values. Paths are resolved by
# scripts/common/env.sh and each experiment's config.yaml; do not commit real
# secrets or absolute personal paths.

# --- API judge (long-multiplication whole-worksheet judge, long-text OCR) ---
# Model used by the paper is "qwen3.8-flash" (as of the last re-eval run).
OPENAI_API_KEY=sk-REPLACE_ME
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_MODEL=qwen3.8-flash

# --- Optional remote logging ---
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=imagereasoning-exp-train

# --- HuggingFace (dataset download / upload) ---
# Datasets are hosted on HF; `source_mode: hf` (the default) downloads by pinned
# revision. See docs/data.md.
HF_ENDPOINT=https://hf-mirror.com           # mirror for restricted networks
HF_TOKEN=                                    # not needed for dataset downloads; gated models or uploads require access
HF_DATASET_NAMESPACE=                        # only needed when HF_DATASET_REPO is a bare repo name
# HF_DATASET_REPO=alfalfa-w/self-conditioning-deep-reasoning-data   # override the dataset repo name
# HF_DATASET_REVISION=                       # pin the exact revision (else 'main'); or set data.hf_revision per config
# HF_DATASET_EXTRACT_ROOT=/path/to/cache      # reusable tar extraction cache (outside HF snapshots)

# --- Structured-task OCR evaluator (Sudoku/Jigsaw) model ---
QWEN3VL_CKPT=Qwen/Qwen3-VL-8B-Instruct

# --- inherit_original mode only (maintainers on the original cluster) ---
# The default source_mode is `hf`. To mirror local checkouts instead, run the
# prepare stage with DATA_SOURCE_MODE=inherit_original and set the relevant roots
# (all SHA-256 + row-count verified; there is no built-in default path):
# DIFFTHINKER_SOURCE=/path/to/endocot                    # 05/06 EndoCoT/DiffThinker tree
# ORIGINAL_REPO_ROOT=/path/to/original/imagereasoning     # 01-04 line / long-mult / long-text / NFE
# DIFFTHINKER_SKIP_HASH=1                                 # bypass sha256 for a deliberate source upgrade
